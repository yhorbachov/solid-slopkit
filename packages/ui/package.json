{
  "name": "@solid-slopkit/ui",
  "version": "0.0.0",
  "description": "Component library for SolidJS 2.x, styled with plain CSS and CSS variables",
  "license": "MIT",
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/source/index.js"
    },
    "./carousel": {
      "types": "./dist/types/carousel/index.d.ts",
      "solid": "./dist/source/carousel/index.js",
      "default": "./dist/source/carousel/index.js"
    },
    "./styles/slopkit.css": "./dist/source/styles/slopkit.css",
    "./styles/default-theme.css": "./dist/source/styles/default-theme.css"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:source && pnpm build:assets",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:source": "tsc -p tsconfig.build.json",
    "build:assets": "node -e \"require('fs').cpSync('src','dist/source',{recursive:true,filter:s=>!require('path').extname(s)||/\\.(css|md)$/.test(s)})\"",
    "test": "vitest run",
    "release:pack": "node scripts/release-pack.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.0"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.0-rc.13",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.46",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.0.2",
    "axe-core": "^4.13.0",
    "embla-carousel": "^8.6.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.11 <3",
    "embla-carousel": "^8.6.0",
    "solid-js": ">=2.0.0-rc.11 <3"
  },
  "peerDependenciesMeta": {
    "embla-carousel": {
      "optional": true
    }
  }
}
