{
  "name": "@solid-slopkit/threejs",
  "version": "0.0.0",
  "description": "three.js scenes as SolidJS 2.x components",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/source/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:source && pnpm build:assets",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:source": "tsc -p tsconfig.build.json",
    "build:assets": "node -e \"require('fs').cpSync('src','dist/source',{recursive:true,filter:s=>!require('path').extname(s)||/\\.md$/.test(s)})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.0-rc.13",
    "@solidjs/vite-plugin": "^3.0.0-next.46",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^5.0.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.11 <3",
    "@types/three": ">=0.171.0 <1",
    "solid-js": ">=2.0.0-rc.11 <3",
    "three": ">=0.171.0 <1"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  }
}
